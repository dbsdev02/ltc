# Backend environment variables — add these in Vercel → (API project) → Settings → Environment Variables.
# For local development, copy to backend/.env (never commit it). All values below are placeholders.

# Neon → Dashboard → Connection Details. Use the POOLED connection string (host contains "-pooler").
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Neon DIRECT (non-pooled) connection string, used only to run migrations during production deploys.
MIGRATION_DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Razorpay → Account & Settings → API Keys (start with TEST keys: rzp_test_…)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
# Razorpay → Account & Settings → Webhooks → the secret you type when creating the webhook
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=little-todds-club

# Long random string (64+ chars). Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# Public site URL (used in emails and links)
FRONTEND_URL=https://littletodds.club
# Only needed if the frontend calls the API from a different domain (normally empty: /api is proxied).
ALLOWED_ORIGINS=

# Resend (resend.com) for order / password emails. Verify littletodds.club in Resend first.
RESEND_API_KEY=
EMAIL_FROM=Little Todds Club <orders@littletodds.club>
NOTIFY_EMAIL=littletoddsclub@gmail.com

# production | development (Vercel sets VERCEL_ENV automatically; this overrides it)
ENVIRONMENT=production

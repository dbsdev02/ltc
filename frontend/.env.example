# Frontend environment variables (Vercel → frontend project → Settings → Environment Variables).
# VITE_* values are bundled into the public JavaScript — NEVER put secrets here.
#
# Leave empty in production: the site calls /api on its own domain and vercel.json
# rewrites it to the API project. Set it only to call an API on another origin.
VITE_API_BASE_URL=

# Backend secrets live in ../backend/.env.example (API project), not here.
